            color: var(--ink) !important; /* Текст всегда плотный черный */
            padding: 4px 10px !important;
        }
        span[class*="bg-green"] { background-color: #10b981 !important; } /* Оплачено */
        span[class*="bg-yellow"] { background-color: #fcd34d !important; } /* Ожидает */
        span[class*="bg-red"] { background-color: #f87171 !important; }    /* Отказ */
        span[class*="bg-gray"] { background-color: #e2e8f0 !important; }   /* Черновик */

        /* 5. ЗАКРЕПЛЕННЫЕ МОНОЛИТНЫЕ ПАНЕЛИ */
        .sticky-action-bar {
            position: sticky;
            bottom: 0;
            background-color: #ffffff;
            border-top: 4px solid var(--ink);
            z-index: 50;
            padding: 1.5rem;
            box-shadow: 0 -10px 0px 0px rgba(15,23,42,0.05) !important;
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            align-items: center;
            margin: 2rem -2rem -2rem -2rem; /* Компенсация паддингов body */
        }
    </style>
    

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">
