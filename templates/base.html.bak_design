<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>ЧИНГИЗХАН ПРО | v2.1{{ title if title else 'Управление' }}</title>
    <script src="{{ url_for('static', filename='css/tailwind.js') }}"></script>
    <link href="{{ url_for('static', filename='css/all.min.css') }}" rel="stylesheet">
    
    <style>
        @import url('{{ url_for("static", filename="fonts/inter.css") }}');
        body { font-family: 'Inter', sans-serif; }
    </style>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --ink: #0f172a; /* Глубокий Slate 900 (Почти черный металл) */
            --paper: #f8fafc; /* Холодный фон */
            --accent: #2563eb; /* Кобальтовый синий */
        }
        
        /* 1. АРХИТЕКТУРНАЯ ТИПОГРАФИКА */
        body { 
            font-family: 'Inter', sans-serif !important; 
            background-color: var(--paper) !important; 
            color: var(--ink) !important; 
        }
        /* Моноширинный шрифт для всех цифр, цен, кодов КНП и инпутов */
        input[type="number"], table td:nth-child(n+3), .text-right, .font-mono { 
            font-family: 'JetBrains Mono', monospace !important; 
            font-weight: 700;
        }

        /* 2. ЖЕСТКИЕ ТЕНИ И РАМКИ (Убиваем мягкость Tailwind) */
        .shadow, .shadow-md, .shadow-lg, .shadow-xl {
            box-shadow: 4px 4px 0px 0px var(--ink) !important;
            border: 2px solid var(--ink) !important;
            border-radius: 0px !important;
            transition: transform 0.1s ease, box-shadow 0.1s ease;
        }
        
        /* Эффект нажатия/наведения на карточки */
        .hover\:shadow-lg:hover {
            box-shadow: 6px 6px 0px 0px var(--ink) !important;
            transform: translate(-2px, -2px);
        }

        /* Инпуты как в инженерных САПР */
        input:not([type="file"]), select, textarea {
            border-radius: 0px !important;
            border: 2px solid #cbd5e1 !important;
            box-shadow: none !important;
        }
        input:focus, select:focus, textarea:focus {
            border-color: var(--ink) !important;
            box-shadow: 4px 4px 0px 0px var(--ink) !important;
            outline: none !important;
        }

        /* 3. ИНДУСТРИАЛЬНЫЕ КНОПКИ */
        button, .btn {
            border-radius: 0px !important;
            text-transform: uppercase;
            font-weight: 900 !important;
            letter-spacing: 0.05em;
        }
        /* Перехватываем стандартные синие кнопки Tailwind */
        [class*="bg-blue-"], [class*="bg-indigo-"] {
            background-color: var(--accent) !important;
            border: 2px solid var(--ink) !important;
            color: #fff !important;
            box-shadow: 4px 4px 0px 0px var(--ink) !important;
        }
        [class*="bg-blue-"]:hover {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px 0px var(--ink) !important;
        }

        /* 4. ПЛОТНЫЕ БЕЙДЖИ СТАТУСОВ */
        /* Перехватываем все скругленные span'ы с цветами (Dashboard, Invoices) */
        span[class*="rounded-full"][class*="bg-"], .badge {
            border-radius: 0px !important;
            border: 2px solid var(--ink) !important;
            box-shadow: 2px 2px 0px 0px var(--ink) !important;
            text-transform: uppercase;
            font-weight: 900 !important;
            letter-spacing: 0.1em;
            color: var(--ink) !important; /* Текст всегда плотный черный */
            padding: 4px 10px !important;
        }
        span[class*="bg-green"] { background-color: #10b981 !important; } /* Оплачено */
        span[class*="bg-yellow"] { background-color: #fcd34d !important; } /* Ожидает */
        span[class*="bg-red"] { background-color: #f87171 !important; }    /* Отказ */
        span[class*="bg-gray"] { background-color: #e2e8f0 !important; }   /* Черновик */

        /* 5. ЗАКРЕПЛЕННЫЕ МОНОЛИТНЫЕ ПАНЕЛИ */
        .sticky-action-bar {
            position: sticky;
            bottom: 0;
            background-color: #ffffff;
            border-top: 4px solid var(--ink);
            z-index: 50;
            padding: 1.5rem;
            box-shadow: 0 -10px 0px 0px rgba(15,23,42,0.05) !important;
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            align-items: center;
            margin: 2rem -2rem -2rem -2rem; /* Компенсация паддингов body */
        }
    </style>
    

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">
