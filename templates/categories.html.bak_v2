{% extends "base.html" %}
{% block content %}
<div class="p-10 max-w-5xl mx-auto">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-3xl font-black text-gray-900 tracking-tight">Категории МАФ</h2>
            <p class="text-gray-400 font-bold text-xs uppercase tracking-widest mt-1">Управление классификатором</p>
        </div>
        <button onclick="openCategoryModal()" class="bg-[#1a1a1a] text-white px-6 py-2.5 rounded-xl font-bold hover:bg-gray-800 transition shadow-lg">
            <i class="fas fa-plus mr-2"></i> Создать категорию
        </button>
    </div>

    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-100 font-black text-gray-400 text-[10px] uppercase tracking-widest">
                    <th class="py-4 px-8">Иконка</th>
                    <th class="py-4 px-8">Название категории</th>
                    <th class="py-4 px-8 text-right">Действия</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                {% for cat in categories %}
                <tr class="hover:bg-gray-50/50 transition">
                    <td class="py-4 px-8">
                        <div class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center border border-gray-200">
                            {% if cat.icon and (cat.icon.endswith('.png') or cat.icon.endswith('.svg') or cat.icon.endswith('.jpg') or cat.icon.endswith('.webp')) %}
                                <img src="/static/category_icons/{{ cat.icon }}" class="w-8 h-8 object-contain">
                            {% else %}
                                <i class="fas {{ cat.icon if cat.icon else 'fa-folder' }} text-gray-400"></i>
                            {% endif %}
                        </div>
                    </td>
                    <td class="py-4 px-8 font-bold text-gray-900 text-lg">{{ cat.name }}</td>
                    <td class="py-4 px-8 text-right space-x-2">
                        <button onclick="openCategoryModal('{{ cat.id }}', '{{ cat.name }}', '{{ cat.icon }}')" class="text-blue-500 hover:bg-blue-50 p-3 rounded-xl transition">
                            <i class="fas fa-pen"></i>
                        </button>
                        <button onclick="deleteCategory('{{ cat.id }}')" class="text-red-400 hover:bg-red-50 p-3 rounded-xl transition">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div id="catModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center backdrop-blur-sm z-50">
    <div class="bg-white p-8 rounded-3xl w-[500px] shadow-2xl animate-fade-in">
        <div class="flex justify-between items-center mb-6">
            <h3 id="modalTitle" class="text-xl font-black text-gray-900">Новая категория</h3>
            <button onclick="closeCategoryModal()" class="text-gray-400 hover:text-gray-900"><i class="fas fa-times text-xl"></i></button>
        </div>

        <div class="space-y-6">
            <input type="hidden" id="catId">
            
            <div>
                <label class="block text-[10px] font-black text-gray-400 uppercase mb-2 tracking-widest">Название</label>
                <input type="text" id="catName" class="w-full bg-gray-50 border border-gray-200 p-3.5 rounded-2xl font-bold outline-none focus:border-blue-500 transition" placeholder="Напр: Скамейки">
            </div>

            <div>
                <label class="block text-[10px] font-black text-gray-400 uppercase mb-2 tracking-widest">Выберите иконку (из папки static/category_icons)</label>
                <div id="iconGrid" class="grid grid-cols-4 gap-3 max-h-48 overflow-y-auto p-3 border border-gray-100 rounded-2xl bg-gray-50">
                    </div>
                <input type="hidden" id="selectedIcon">
            </div>

            <button onclick="saveCategory()" class="w-full bg-[#1a1a1a] text-white py-4 rounded-2xl font-black uppercase tracking-widest hover:bg-black shadow-lg transition">
                Сохранить категорию
            </button>
        </div>
    </div>
</div>

<script>
    let localIcons = [];

    document.addEventListener('DOMContentLoaded', function() {
        fetch('/api/get_local_icons')
            .then(r => r.json())
            .then(data => {
                localIcons = data;
            });
    });

    function openCategoryModal(id = '', name = '', icon = '') {
        document.getElementById('catId').value = id;
        document.getElementById('catName').value = name;
        document.getElementById('selectedIcon').value = icon;
        document.getElementById('modalTitle').innerText = id ? 'Редактировать' : 'Новая категория';
        
        renderIconGrid(icon);
        
        document.getElementById('catModal').classList.remove('hidden');
        document.getElementById('catModal').classList.add('flex');
    }

    function closeCategoryModal() {
        document.getElementById('catModal').classList.add('hidden');
        document.getElementById('catModal').classList.remove('flex');
    }

    function renderIconGrid(currentIcon) {
        const grid = document.getElementById('iconGrid');
        if (localIcons.length === 0) {
            grid.innerHTML = '<div class="col-span-4 text-[10px] text-center text-gray-400 font-bold p-4 uppercase">Папка static/category_icons пуста</div>';
            return;
        }

        grid.innerHTML = localIcons.map(fileName => {
            const isSelected = fileName === currentIcon;
            return `
                <div onclick="selectIcon('${fileName}')" id="icon-${fileName.replace(/\\./g, '-')}" 
                     class="icon-item cursor-pointer p-2 border-2 ${isSelected ? 'border-blue-500 bg-white' : 'border-transparent'} hover:border-blue-200 rounded-xl transition flex flex-col items-center">
                    <img src="/static/category_icons/${fileName}" class="w-8 h-8 object-contain">
                    <div class="text-[8px] mt-1 text-gray-400 truncate w-full text-center" title="${fileName}">${fileName}</div>
                </div>
            `;
        }).join('');
    }

    function selectIcon(fileName) {
        document.getElementById('selectedIcon').value = fileName;
        document.querySelectorAll('.icon-item').forEach(el => el.classList.replace('border-blue-500', 'border-transparent'));
        document.getElementById('icon-' + fileName.replace(/\\./g, '-')).classList.replace('border-transparent', 'border-blue-500');
    }

    function saveCategory() {
        const id = document.getElementById('catId').value;
        const name = document.getElementById('catName').value;
        const icon = document.getElementById('selectedIcon').value;

        if (!name || !icon) {
            alert("Заполни название и выбери иконку!");
            return;
        }

        const url = id ? '/api/edit_category' : '/api/add_category';
        const body = id ? { id, name, icon } : { name, icon };

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        }).then(() => window.location.reload());
    }

    // ИСПРАВЛЕНО: Теперь ID правильно подставляется в ссылку для удаления
    function deleteCategory(id) {
        if (confirm('Удалить эту категорию? Товары в ней могут остаться без привязки.')) {
            fetch('/api/delete_category/' + id, {
                method: 'POST'
            }).then(() => window.location.reload());
        }
    }
</script>
{% endblock %}